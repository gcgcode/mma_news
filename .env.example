# ============================================================
# DEMOCLES — variables de entorno
# Copia este archivo a .env y rellena. NUNCA subas .env a git.
# ============================================================

# ---------- Telegram (obligatorio) ----------
# Crea el bot con @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Tu chat privado. Para obtenerlo: escribe al bot y visita
# https://api.telegram.org/bot<TOKEN>/getUpdates  -> message.chat.id
TELEGRAM_CHAT_ID=123456789
# Usuarios autorizados a usar /add (IDs numéricos, separados por coma). Máx 3.
TELEGRAM_ALLOWED_USERS=123456789

# ---------- LLM (obligatorio) ----------
# gemini | groq | openai | together | anthropic
LLM_PROVIDER=gemini
# LLM_MODEL admite una LISTA separada por comas: si el primero da 429 (cuota) o
# 404 (retirado), se pasa automáticamente al siguiente.
# OJO: los modelos gemini-2.x devuelven 404 en claves creadas desde 2026.
LLM_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash

# Solo el del proveedor que uses:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=

# Presupuesto de salida por llamada. NO lo bajes de 3000 con modelos que razonan
# (Gemini 3.x): el razonamiento consume del mismo presupuesto que la respuesta y
# el JSON se corta a media frase. Medido: 700-1200 tokens sólo de razonamiento.
LLM_MAX_TOKENS=4000

# Umbral de relevancia para enviar a Telegram (por defecto 7)
RELEVANCE_THRESHOLD=7
# Tope de llamadas al LLM por ejecución (protege el free tier)
MAX_LLM_CALLS=25

# ---------- Reddit (OPCIONAL) ----------
# Por defecto se usa el RSS público, que no necesita credenciales.
# La API oficial ahora exige solicitar permiso a Reddit; cuando te lo aprueben,
# rellena estas dos claves y activa "r/MMA (API oficial)" en config.yaml.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Este SÍ conviene rellenarlo aunque no tengas API: Reddit trata mucho mejor a
# los clientes que se identifican con un User-Agent propio.
REDDIT_USER_AGENT=democles-mma-bot/1.0 by u/tu_usuario

# ---------- Twitter/X (opcional, degradación elegante) ----------
# Orden de intentos separado por comas: rsshub,nitter,apify  (vacío = desactivado)
TWITTER_STRATEGY=rsshub,nitter
# RSSHub auto-hospedado (Koyeb/Render/Oracle). Sin barra final.
RSSHUB_BASE=
# Token opcional si tu RSSHub tiene ACCESS_KEY
RSSHUB_ACCESS_KEY=
# Espejos Nitter, separados por coma (frágiles, cambian a menudo)
NITTER_MIRRORS=
# Apify (plan free trae créditos mensuales; verifica el plan vigente)
APIFY_TOKEN=
APIFY_ACTOR=apidojo~tweet-scraper

# ---------- Varios ----------
STATE_FILE=state/state.json
LOG_LEVEL=INFO
